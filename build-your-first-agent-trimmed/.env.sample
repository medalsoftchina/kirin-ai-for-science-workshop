# Azure AI Foundry プロジェクトのエンドポイント
# Azure AI Foundry ポータル → プロジェクトの「概要」ページで確認できます。
# <foundry名> の部分を自分の環境に合わせて書き換えてください。
PROJECT_ENDPOINT=https://<foundry名>.services.ai.azure.com/api/projects/kirin-rnd-lab

# 使用するモデルのデプロイ名 (Foundry ポータルの「モデル + エンドポイント」で確認)
# ※ Lab 3 (Agent Service) は gpt-4.1 を使います。
#   gpt-6-luna などのプレビューモデルは 2026-09-28 時点で Agent Service の
#   run が失敗するため (top_p 非対応 / server_error)、GA モデルを使用します。
MODEL_DEPLOYMENT_NAME=gpt-4.1
