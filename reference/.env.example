# .env にコピーして値を記入してください (.env は gitignore されています)

# Azure OpenAI (GraphRAG のインデックス構築・検索に使用)
AZURE_OPENAI_ENDPOINT=https://<リソース名>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_EMB_DEPLOYMENT=text-embedding-3-large

# GraphRAG のインデックスを置くルート
GRAPHRAG_ROOT=data/graphrag
